# OpenAI API Key (Required for GPT-4o-mini and text-embedding-3-small)
OPENAI_API_KEY="sk-..."

# Firebase Service Account Key JSON Path (for Cloud Firestore Vector Search)
# Example: FIREBASE_SERVICE_ACCOUNT_KEY="./serviceAccountKey.json"
# Or place your serviceAccountKey.json directly in the backend/ directory.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# LangSmith LLM Tracing & Observability (Optional)
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="Attocus-Platform"
